{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "peritto-petatto",
  "version": "0.1.0",
  "identifier": "com.perittopetatto.desktop",
  "build": {
    "frontendDist": "../dist/client",
    "beforeDevCommand": { "script": "vp dev", "cwd": ".." },
    "beforeBuildCommand": { "script": "vp build", "cwd": ".." },
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "peritto-petatto",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
